doctype html
html
  head
    title= title
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    style.
      :root {
        --gradient-start: #667eea;
        --gradient-end: #764ba2;
      }
      body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
      }
      .card-header {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        color: white;
        border-radius: 1rem 1rem 0 0 !important;
        padding: 1.5rem;
        font-weight: 600;
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border: none;
        transition: transform 0.2s;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102,126,234,0.4);
      }
      .order-status {
        padding: 1rem;
        border-radius: 0.5rem;
        margin-top: 1rem;
        font-weight: 500;
      }
      .status-approved {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
      }
      .status-rejected {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
      }
      .table-hover tbody tr:hover {
        background-color: rgba(102,126,234,0.05);
      }
      .badge-approved {
        background-color: #28a745 !important;
      }
      .badge-rejected {
        background-color: #dc3545 !important;
      }
      .fade-in {
        animation: fadeIn 0.5s;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .btn-submit-order {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        border: none;
        color: white;
        font-weight: 600;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .btn-submit-order:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(17,153,142,0.4);
      }
  body
    .container.mt-5
      #loginSection.fade-in
        .row.justify-content-center
          .col-md-5
            .card
              .card-header.text-center
                i.bi.bi-shield-lock.me-2
                | TradeGuard Login
              .card-body.p-4
                form#loginForm
                  .mb-3
                    label.form-label Username
                    .input-group
                      span.input-group-text: i.bi.bi-person
                      input#username.form-control(type="text" placeholder="Enter username" required)
                  .mb-3
                    label.form-label Password
                    .input-group
                      span.input-group-text: i.bi.bi-key
                      input#password.form-control(type="password" placeholder="Enter password" required)
                  button#loginBtn.btn.btn-primary.w-100(type="submit") Login
                  #loginError.text-danger.mt-2.small

      #orderSection(style="display:none")
        .row.mb-4
          .col
            .card.fade-in
              .card-header.d-flex.justify-content-between.align-items-center
                span: i.bi.bi-graph-up-arrow.me-2 | Submit Order
                button#logoutBtn.btn.btn-sm.btn-outline-light Logout
              .card-body
                form#orderForm
                  .row
                    .col-md-3.mb-3
                      label.form-label Symbol
                      .input-group
                        span.input-group-text: i.bi.bi-currency-dollar
                        input#symbol.form-control(type="text" placeholder="AAPL" required)
                    .col-md-3.mb-3
                      label.form-label Quantity
                      .input-group
                        span.input-group-text: i.bi.bi-hash
                        input#quantity.form-control(type="number" step="any" placeholder="100" required)
                    .col-md-3.mb-3
                      label.form-label Price
                      .input-group
                        span.input-group-text: i.bi.bi-tag
                        input#price.form-control(type="number" step="any" placeholder="150.00" required)
                    .col-md-3.mb-3
                      label.form-label Trader
                      .input-group
                        span.input-group-text: i.bi.bi-person-badge
                        input#traderName.form-control(type="text" placeholder="JohnDoe" required)
                  button.btn.btn-submit-order.w-100(type="submit") Submit Order
                #orderResult.mt-3

        .row
          .col
            .card.fade-in
              .card-header.d-flex.justify-content-between.align-items-center
                span: i.bi.bi-clock-history.me-2 | Order History
                // Token hidden for security
              .card-body
                .table-responsive
                  table.table.table-hover
                    thead.table-light
                      tr
                        th ID
                        th Symbol
                        th Qty
                        th Price
                        th Trader
                        th Status
                        th Time
                    tbody#historyBody

    script(src=`/js/app.js?v=${Date.now()}`)
